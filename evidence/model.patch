+package edge
+
+// End-to-end tests for carrier address generations: when DNS moves a
+// carrier to a new target, NEW transactions leave from the new snapshot, a
+// live call keeps using its creation-time connection, and after that
+// connection is lost the call's in-dialog traffic redials the OLD remote
+// with the same carrier's settings. The last related dialog to end reclaims
+// the retired route. Two real stream gateways stand in for the two
+// generations on loopback; the carrier resolves through SRV so the target
+// port can change while its name stays the same.
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/emiago/sipgo/sip"
+)
+
+const genCarrierHost = "gw.alpha.test"
+
+// genRig is one edge with carrier "alpha" resolving through SRV, with a
+// gateway per DNS generation.
+type genRig struct {
+	h     *harness
+	fs    *fakeSwitch
+	stub  *dnsStub
+	oldGW *streamCarrier
+	newGW *streamCarrier
+}
+
+func startGenerationRig(t *testing.T) *genRig {
+	t.Helper()
+	oldGW := startStreamCarrier(t, "tcp", nil, insecureClient())
+	newGW := startStreamCarrier(t, "tcp", nil, insecureClient())
+
+	pubUDP, priv, up, cp := freePort(t), freePort(t), freePort(t), freePort(t)
+	mediaBase := nextMediaBase(t)
+	entry := fmt.Sprintf("alpha: {host: %q, transport: tcp}", genCarrierHost)
+	yaml := harnessYAML(t, []string{fmt.Sprintf("127.0.0.1:%d", up)}, pubUDP, 0, 0, mediaBase, "")
+	yaml = strings.Replace(yaml, "edge:\n",
+		fmt.Sprintf("edge:\n  switch_carrier_port: %d\n  carriers:\n    %s\n", cp, entry), 1)
+	h := newHarness(t, yaml, priv)
+	h.upstream = fmt.Sprintf("127.0.0.1:%d", up)
+	fs := startFakeSwitch(t, h.upstream)
+	cs := startFakeSwitch(t, fmt.Sprintf("127.0.0.1:%d", cp))
+	h.upstreams["carrier-port"] = cs
+
+	stub := &dnsStub{
+		srv: map[string][]*net.SRV{genCarrierHost: {
+			{Target: genCarrierHost + ".", Port: uint16(oldGW.port), Priority: 0, Weight: 1},
+		}},
+		ips: map[string][]string{genCarrierHost: {"127.0.0.1"}},
+	}
+	h.srv.carriers.lookupSRV, h.srv.carriers.lookupIP = stub.lookupSRV, stub.lookupIP
+	h.run()
+
+	rig := &genRig{h: h, fs: fs, stub: stub, oldGW: oldGW, newGW: newGW}
+	waitFor(t, 5*time.Second, "the first generation to resolve", func() bool {
+		dest, ok := h.srv.carrierDest("alpha")
+		return ok && dest == fmt.Sprintf("127.0.0.1:%d", oldGW.port)
+	})
+	return rig
+}
+
+func startTLSGenerationRig(t *testing.T) *genRig {
+	t.Helper()
+	pki := newTestPKI(t)
+	leaf := pki.issue(false, []string{genCarrierHost})
+	serverConf := tlsServerConf(leaf)
+
+	oldGW := startStreamCarrier(t, "tls", serverConf, insecureClient())
+	newGW := startStreamCarrier(t, "tls", serverConf, insecureClient())
+
+	pubUDP, priv, up, cp := freePort(t), freePort(t), freePort(t), freePort(t)
+	mediaBase := nextMediaBase(t)
+	entry := fmt.Sprintf("alpha: {host: %q, transport: tls, ca_file: %q}", genCarrierHost, pki.caFile())
+	yaml := harnessYAML(t, []string{fmt.Sprintf("127.0.0.1:%d", up)}, pubUDP, 0, 0, mediaBase, "")
+	yaml = strings.Replace(yaml, "edge:\n",
+		fmt.Sprintf("edge:\n  switch_carrier_port: %d\n  carriers:\n    %s\n", cp, entry), 1)
+	h := newHarness(t, yaml, priv)
+	h.upstream = fmt.Sprintf("127.0.0.1:%d", up)
+	fs := startFakeSwitch(t, h.upstream)
+	cs := startFakeSwitch(t, fmt.Sprintf("127.0.0.1:%d", cp))
+	h.upstreams["carrier-port"] = cs
+
+	stub := &dnsStub{
+		srv: map[string][]*net.SRV{genCarrierHost: {
+			{Target: genCarrierHost + ".", Port: uint16(oldGW.port), Priority: 0, Weight: 1},
+		}},
+		ips: map[string][]string{genCarrierHost: {"127.0.0.1"}},
+	}
+	h.srv.carriers.lookupSRV, h.srv.carriers.lookupIP = stub.lookupSRV, stub.lookupIP
+	h.run()
+
+	rig := &genRig{h: h, fs: fs, stub: stub, oldGW: oldGW, newGW: newGW}
+	waitFor(t, 5*time.Second, "the first generation to resolve", func() bool {
+		dest, ok := h.srv.carrierDest("alpha")
+		return ok && dest == fmt.Sprintf("127.0.0.1:%d", oldGW.port)
+	})
+	return rig
+}
+
+func (g *genRig) carrierURI() sip.Uri {
+	return sip.Uri{User: "+442071234567", Host: genCarrierHost, Port: 5060}
+}
+
+// place has the switch place a call that the given gateway answers.
+func (g *genRig) place(t *testing.T, gw *streamCarrier) *sip.Response {
+	t.Helper()
+	res := g.fs.call(t, g.carrierURI(), g.h.privateSIP, phoneOfferSDP(g.fs.rtpPort))
+	if res.StatusCode != 200 {
+		t.Fatalf("INVITE to the carrier: got %d, want 200", res.StatusCode)
+	}
+	gw.waitInbound(t, sip.INVITE)
+	g.fs.sendAckTo2xx(t, res)
+	gw.waitInbound(t, sip.ACK)
+	return res
+}
+
+// flip moves the SRV target to gw and refreshes the directory.
+func (g *genRig) flip(t *testing.T, gw *streamCarrier) {
+	t.Helper()
+	g.stub.mu.Lock()
+	g.stub.srv[genCarrierHost] = []*net.SRV{
+		{Target: genCarrierHost + ".", Port: uint16(gw.port), Priority: 0, Weight: 1},
+	}
+	g.stub.mu.Unlock()
+	d := g.h.srv.carriers
+	d.mu.Lock()
+	e := d.entries["alpha"]
+	if e == nil {
+		d.mu.Unlock()
+		t.Fatal("the carrier has no cache entry to expire")
+	}
+	e.expiry = time.Now().Add(-time.Second)
+	d.mu.Unlock()
+	d.refresh(context.Background())
+	want := fmt.Sprintf("127.0.0.1:%d", gw.port)
+	if dest, ok := g.h.srv.carrierDest("alpha"); !ok || dest != want {
+		t.Fatalf("after the refresh carrierDest = %q,%v, want %s", dest, ok, want)
+	}
+}
+
+// awaitPoolMiss waits until sipgo's pool no longer holds a connection to
+// dest over network, as TestCarrierConnectionRedialAndShutdown does.
+func (g *genRig) awaitPoolMiss(t *testing.T, network, dest string) {
+	t.Helper()
+	waitFor(t, 5*time.Second, "the old connection leaving the pool", func() bool {
+		c, err := g.h.srv.srv.TransportLayer().GetConnection(network, dest)
+		if err == nil && c != nil {
+			_, _ = c.TryClose()
+			return false
+		}
+		return true
+	})
+}
+
+// A refresh splits traffic by generation: the new call takes the new
+// snapshot, both calls' in-dialog traffic keeps each one's own connection,
+// and the retired routes are reclaimed once both calls end.
+func TestCarrierGenerationNewCallUsesSnapshotOldCallKeepsRoute(t *testing.T) {
+	rig := startGenerationRig(t)
+	res1 := rig.place(t, rig.oldGW)
+
+	rig.flip(t, rig.newGW)
+	res2 := rig.place(t, rig.newGW)
+	rig.oldGW.noInbound(t) // the new transaction never fell back to the old target
+
+	if bye := rig.fs.uacBye(t, res1); bye.StatusCode != 200 {
+		t.Fatalf("BYE on the old generation: got %d, want 200", bye.StatusCode)
+	}
+	rig.oldGW.waitInbound(t, sip.BYE)
+	if n := rig.oldGW.ln.accepted(); n != 1 {
+		t.Errorf("old gateway accepted %d connections, want the one reused for the call and its BYE", n)
+	}
+	if bye := rig.fs.uacBye(t, res2); bye.StatusCode != 200 {
+		t.Fatalf("BYE on the new generation: got %d, want 200", bye.StatusCode)
+	}
+	rig.newGW.waitInbound(t, sip.BYE)
+	if n := rig.newGW.ln.accepted(); n != 1 {
+		t.Errorf("new gateway accepted %d connections, want one", n)
+	}
+	waitForRelease(t, rig.h)
+	if n := rig.h.srv.carriers.pinCount(); n != 0 {
+		t.Errorf("%d retired routes remain after both dialogs ended", n)
+	}
+}
+
+// With the creation-time connection gone, the old dialog redials the OLD
+// remote with its own carrier identity, while the new-generation call is
+// untouched. Runs over TCP and TLS, so the redial keeps the pinned
+// carrier's SNI/CA/client certificate configuration.
+func TestCarrierGenerationRedialsOldRemoteAfterFlowLoss(t *testing.T) {
+	for _, transport := range []string{"tcp", "tls"} {
+		t.Run(transport, func(t *testing.T) {
+			var rig *genRig
+			if transport == "tls" {
+				rig = startTLSGenerationRig(t)
+			} else {
+				rig = startGenerationRig(t)
+			}
+			res1 := rig.place(t, rig.oldGW)
+
+			rig.flip(t, rig.newGW)
+			res2 := rig.place(t, rig.newGW)
+			rig.oldGW.noInbound(t)
+
+			oldDest := fmt.Sprintf("127.0.0.1:%d", rig.oldGW.port)
+			rig.oldGW.ln.closeAccepted()
+			rig.awaitPoolMiss(t, transport, oldDest)
+
+			if bye := rig.fs.uacBye(t, res1); bye.StatusCode != 200 {
+				t.Fatalf("BYE after the old flow was lost: got %d, want 200", bye.StatusCode)
+			}
+			rig.oldGW.waitInbound(t, sip.BYE)
+			if n := rig.oldGW.ln.accepted(); n != 2 {
+				t.Errorf("old gateway accepted %d connections, want a second one for the redial", n)
+			}
+
+			if bye := rig.fs.uacBye(t, res2); bye.StatusCode != 200 {
+				t.Fatalf("BYE on the current generation: got %d, want 200", bye.StatusCode)
+			}
+			rig.newGW.waitInbound(t, sip.BYE)
+			if n := rig.newGW.ln.accepted(); n != 1 {
+				t.Errorf("new gateway accepted %d connections, want one", n)
+			}
+			waitForRelease(t, rig.h)
+			if n := rig.h.srv.carriers.pinCount(); n != 0 {
+				t.Errorf("%d retired routes remain after both dialogs ended", n)
+			}
+		})
+	}
+}
+
+// A CANCEL for a still-early call follows its creation-time generation: the
+// snapshot moved and the original connection was lost, so the CANCEL
+// redials the old remote and the switch gets its 487.
+func TestCarrierGenerationCancelRedialsOldRemote(t *testing.T) {
+	rig := startGenerationRig(t)
+	rig.oldGW.setAnswer(func(req *sip.Request, tx sip.ServerTransaction) {
+		switch req.Method {
+		case sip.INVITE:
+			_ = tx.Respond(sip.NewResponseFromRequest(req, 100, "Trying", nil))
+		default: // CANCEL and everything else are answered
+			_ = tx.Respond(sip.NewResponseFromRequest(req, 200, "OK", nil))
+		}
+	})
+
+	req, final := rig.fs.callAsync(t, rig.carrierURI(), rig.h.privateSIP, phoneOfferSDP(rig.fs.rtpPort))
+	rig.oldGW.waitInbound(t, sip.INVITE)
+
+	rig.flip(t, rig.newGW)
+	rig.oldGW.ln.closeAccepted()
+	rig.awaitPoolMiss(t, "tcp", fmt.Sprintf("127.0.0.1:%d", rig.oldGW.port))
+
+	cancelReq := buildCancelFor(req)
+	cancelReq.SetTransport("UDP")
+	cancelReq.SetDestination(rig.h.privateSIP)
+	cancelReq.Laddr = req.Laddr
+	ctx, stop := context.WithTimeout(context.Background(), 10*time.Second)
+	defer stop()
+	tx, err := rig.fs.cli.TransactionRequest(ctx, cancelReq)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Terminate()
+	select {
+	case res := <-tx.Responses():
+		if res.StatusCode != 200 {
+			t.Fatalf("CANCEL: got %d, want 200", res.StatusCode)
+		}
+	case <-ctx.Done():
+		t.Fatal("the CANCEL got no response")
+	}
+	select {
+	case res := <-final:
+		if res == nil || res.StatusCode != 487 {
+			t.Fatalf("INVITE final after CANCEL = %v, want 487", res)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("no final response after CANCEL")
+	}
+	rig.oldGW.waitInbound(t, sip.CANCEL)
+	if n := rig.oldGW.ln.accepted(); n != 2 {
+		t.Errorf("old gateway accepted %d connections, want the CANCEL redialed onto a second one", n)
+	}
+	waitForRelease(t, rig.h)
+	if n := rig.h.srv.carriers.pinCount(); n != 0 {
+		t.Errorf("%d retired routes remain after the early dialog ended", n)
+	}
+}
diff --git a/internal/edge/carrierpins_test.go b/internal/edge/carrierpins_test.go
new file mode 100644
index 0000000..548ab29
--- /dev/null
+++ b/internal/edge/carrierpins_test.go
@@ -0,0 +1,253 @@
+package edge
+
+// Tests for the creation-time carrier route registry (carrierdns.go): a
+// dialog pins the carrier generation it was born on, so a DNS refresh that
+// changes the snapshot moves only NEW transactions while live dialogs keep
+// their old remote dialable with their own carrier identity until the last
+// one ends and reclaims the retired route.
+
+import (
+	"context"
+	"errors"
+	"io"
+	"log/slog"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/emiago/sipgo/sip"
+
+	"github.com/freesbc/freesbc/internal/config"
+)
+
+// A retained route survives a refresh that retired it; the released one is
+// reclaimed by the last dialog, idempotently. Empty and "unknown" carriers
+// pin nothing; UDP pins are bookkeeping, never connections.
+func TestCarrierRoutePinLifecycle(t *testing.T) {
+	stub := &dnsStub{ips: map[string][]string{"gw.example": {"192.0.2.1"}}}
+	clk := &fakeClock{t: time.Unix(1000, 0)}
+	d := newTestDirectory(stub, clk, nil,
+		config.Carrier{Name: "alpha", Host: "gw.example", Port: 5060, ExplicitPort: true, Transport: config.CarrierTCP})
+	d.refresh(context.Background())
+	old := "192.0.2.1:5060"
+
+	if d.pinCount() != 0 {
+		t.Fatalf("pin count = %d, want 0 before any dialog", d.pinCount())
+	}
+	for _, c := range []string{"", carrierUnknown} {
+		rel := d.retain(c, "tcp", old)
+		rel()
+		if d.pinCount() != 0 {
+			t.Errorf("carrier %q created a pin", c)
+		}
+	}
+
+	rel1 := d.retain("alpha", "tcp", old)
+	rel2 := d.retain("alpha", "tcp", old)
+	if !d.pinnedRoute("alpha", "tcp", old) {
+		t.Fatal("the route is not pinned while dialogs hold it")
+	}
+	if d.pinCount() != 1 {
+		t.Errorf("pin count = %d, want one shared record", d.pinCount())
+	}
+	rel1()
+	if !d.pinnedRoute("alpha", "tcp", old) {
+		t.Fatal("the route was reclaimed while a second dialog still holds it")
+	}
+	rel1() // an idempotent release changes nothing
+	if !d.pinnedRoute("alpha", "tcp", old) {
+		t.Fatal("a duplicate release reclaimed the route early")
+	}
+	rel2()
+	if d.pinnedRoute("alpha", "tcp", old) || d.pinCount() != 0 {
+		t.Fatalf("the last dialog did not reclaim the route (pins=%d)", d.pinCount())
+	}
+}
+
+// After a successful refresh the snapshot admits only the new generation:
+// exactCarrier, carrierFor and the source prefixes no longer name the old
+// address, while a dialog born on it keeps its pin. The pin never feeds the
+// snapshot, so the retired address cannot be readmitted to new transactions.
+func TestCarrierRouteRetirementAcrossRefresh(t *testing.T) {
+	stub := &dnsStub{ips: map[string][]string{"gw.example": {"192.0.2.1"}}}
+	clk := &fakeClock{t: time.Unix(1000, 0)}
+	d := newTestDirectory(stub, clk, nil,
+		config.Carrier{Name: "alpha", Host: "gw.example", Port: 5060, ExplicitPort: true, Transport: config.CarrierTCP})
+	d.refresh(context.Background())
+	old, fresh := "192.0.2.1:5060", "192.0.2.2:5060"
+	if name, ok := d.snapshot().exactCarrier("tcp", old); !ok || name != "alpha" {
+		t.Fatalf("exactCarrier(old) before refresh = %q,%v", name, ok)
+	}
+
+	release := d.retain("alpha", "tcp", old) // the dialog born on the first generation
+
+	stub.mu.Lock()
+	stub.ips["gw.example"] = []string{"192.0.2.2"}
+	stub.mu.Unlock()
+	clk.advance(carrierDNSTTL + time.Second)
+	d.refresh(context.Background())
+
+	snap := d.snapshot()
+	if got := snap.addrs["alpha"]; len(got) != 1 || got[0] != ap(fresh) {
+		t.Fatalf("addrs after refresh = %v, want %s", got, fresh)
+	}
+	if _, ok := snap.exactCarrier("tcp", old); ok {
+		t.Error("a retired address is still a new-transaction target")
+	}
+	if name, ok := snap.exactCarrier("tcp", fresh); !ok || name != "alpha" {
+		t.Errorf("the current address = %q,%v, want alpha,true", name, ok)
+	}
+	if snap.isSource(ap(old).Addr()) {
+		t.Error("the retired address is still a carrier source after the refresh")
+	}
+	if _, ok := snap.carrierFor(ap(old), "tcp"); ok {
+		t.Error("the retired address is still admitted as a carrier's")
+	}
+	// The existing dialog keeps its route, and is the single owner.
+	if !d.pinnedRoute("alpha", "tcp", old) {
+		t.Error("the dialog's creation-time route was lost")
+	}
+	if owner, ok := d.retiredOwner("tcp", old); !ok || owner != "alpha" {
+		t.Errorf("retiredOwner = %q,%v, want alpha,true", owner, ok)
+	}
+
+	release()
+	if _, ok := d.retiredOwner("tcp", old); ok || d.pinCount() != 0 {
+		t.Fatalf("the retired route survived its last dialog (pins=%d)", d.pinCount())
+	}
+
+	// A failed refresh keeps the last good set: the current generation is
+	// unchanged, and with no pin the old question simply has no owner.
+	stub.mu.Lock()
+	stub.ipErr = errors.New("resolver down")
+	stub.mu.Unlock()
+	clk.advance(carrierDNSTTL + time.Second)
+	d.refresh(context.Background())
+	if got := d.snapshot().addrs["alpha"]; len(got) != 1 || got[0] != ap(fresh) {
+		t.Errorf("addrs after a failed refresh = %v, want the last good %s", got, fresh)
+	}
+
+	// Swing back: the address becoming current again is selected through
+	// the snapshot, not through the retired pin.
+	stub.mu.Lock()
+	stub.ipErr = nil
+	stub.ips["gw.example"] = []string{"192.0.2.1"}
+	stub.mu.Unlock()
+	clk.advance(carrierDNSTTL + time.Second)
+	d.refresh(context.Background())
+	if _, ok := d.snapshot().exactCarrier("tcp", old); !ok {
+		t.Error("an address that became current again is not selected")
+	}
+}
+
+// The same old destination pinned by two different carriers (each retired
+// it on its own generation) has no single owner: a teardown without a hint
+// fails closed, while each dialog still reaches its own carrier by name.
+func TestCarrierRouteSameAddressTwoCarriers(t *testing.T) {
+	stub := &dnsStub{ips: map[string][]string{
+		"gw-a.example": {"192.0.2.9"},
+		"gw-b.example": {"192.0.2.9"},
+	}}
+	d := newTestDirectory(stub, &fakeClock{t: time.Unix(1000, 0)}, nil,
+		config.Carrier{Name: "alpha", Host: "gw-a.example", Port: 5060, ExplicitPort: true, Transport: config.CarrierTCP},
+		config.Carrier{Name: "beta", Host: "gw-b.example", Port: 5060, ExplicitPort: true, Transport: config.CarrierTCP})
+	d.refresh(context.Background())
+	dest := "192.0.2.9:5060"
+	relA := d.retain("alpha", "tcp", dest)
+	relB := d.retain("beta", "tcp", dest)
+	defer relA()
+	defer relB()
+
+	if !d.pinnedRoute("alpha", "tcp", dest) || !d.pinnedRoute("beta", "tcp", dest) {
+		t.Fatal("each carrier keeps its own pin on the shared address")
+	}
+	if owner, ok := d.retiredOwner("tcp", dest); ok {
+		t.Errorf("ambiguous ownership resolved to %q; want fail closed", owner)
+	}
+	// Distinct transports stay distinct routes.
+	relU := d.retain("alpha", "udp", dest)
+	if owner, ok := d.retiredOwner("udp", dest); !ok || owner != "alpha" {
+		t.Errorf("udp owner = %q,%v, want alpha,true", owner, ok)
+	}
+	relU()
+}
+
+// Parallel retain/release against one directory settles at zero with no
+// lost reference (run under -race).
+func TestCarrierRoutePinConcurrent(t *testing.T) {
+	d := newTestDirectory(&dnsStub{}, &fakeClock{t: time.Unix(1000, 0)}, nil)
+	var wg sync.WaitGroup
+	for g := 0; g < 32; g++ {
+		wg.Add(1)
+		go func(n int) {
+			defer wg.Done()
+			carrier := "alpha"
+			if n%2 == 0 {
+				carrier = "beta"
+			}
+			for i := 0; i < 100; i++ {
+				rel := d.retain(carrier, "tcp", "192.0.2.5:5060")
+				rel()
+			}
+		}(g)
+	}
+	wg.Wait()
+	if d.pinCount() != 0 {
+		t.Errorf("pin count after all releases = %d, want 0", d.pinCount())
+	}
+}
+
+// A connection serving an early dialog (a reliable 18x a PRACK follows) is
+// kept busy by the fork's recorded route, even before the 2xx confirms the
+// dialog; ending the dialog releases it.
+func TestUsesRemoteCoversEarlyFork(t *testing.T) {
+	tab := newDialogTable(NewMetrics(), slog.New(slog.NewTextHandler(io.Discard, nil)))
+	req := sip.NewRequest(sip.INVITE, sip.Uri{User: "3003", Host: "gw.example", Port: 5060})
+	from := &sip.FromHeader{Address: sip.Uri{User: "3003", Host: "gw.example"}, Params: sip.NewParams()}
+	from.Params.Add("tag", "caller-tag")
+	req.AppendHeader(from)
+	cid := sip.CallIDHeader("early@example")
+	req.AppendHeader(&cid)
+
+	d, res := tab.begin(req, planePrivate, 0)
+	if res != beginOK {
+		t.Fatalf("begin = %v, want beginOK", res)
+	}
+	const remote, network = "192.0.2.4:5061", "tls"
+	if tab.usesRemote(network, remote) {
+		t.Fatal("a fresh dialog is already routed to the carrier remote")
+	}
+	d.setForkRoute("fork-tag", dialogRoute{publicRemote: remote, transport: network})
+	if !tab.usesRemote("TLS", remote) { // transport compares case-insensitively
+		t.Error("the early fork's route does not keep the connection busy")
+	}
+	if tab.usesRemote("tcp", remote) {
+		t.Error("the early route matched the wrong transport")
+	}
+	d.end(endShutdown)
+	if tab.usesRemote(network, remote) {
+		t.Error("the route still keeps the connection busy after the dialog ended")
+	}
+}
+
+// A route pin attached right as the dialog ends is released immediately, so
+// it never leaks through the shutdown/answer race.
+func TestAttachRoutePinAfterEndReleases(t *testing.T) {
+	tab := newDialogTable(NewMetrics(), slog.New(slog.NewTextHandler(io.Discard, nil)))
+	req := sip.NewRequest(sip.INVITE, sip.Uri{User: "3003", Host: "gw.example", Port: 5060})
+	from := &sip.FromHeader{Address: sip.Uri{User: "3003", Host: "gw.example"}, Params: sip.NewParams()}
+	from.Params.Add("tag", "late-tag")
+	req.AppendHeader(from)
+	cid := sip.CallIDHeader("late@example")
+	req.AppendHeader(&cid)
+	d, res := tab.begin(req, planePrivate, 0)
+	if res != beginOK {
+		t.Fatalf("begin = %v, want beginOK", res)
+	}
+	d.end(endByeCaller)
+	released := false
+	d.attachRoutePin(func() { released = true })
+	if !released {
+		t.Error("a pin attached after end() was not released at once")
+	}
+}
